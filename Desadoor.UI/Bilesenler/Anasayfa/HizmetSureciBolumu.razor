@using Desadoor.Ortak.Modeller
@inject Servisler.ApiIstemcisi api
@inject Servisler.DilServisi dil

@if (_adimlar.Any())
{
    <MudPaper Elevation="0" Square="true" Style="background: var(--desa-bg-base); padding: 96px 0;">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="px-6">
            <MudStack AlignItems="AlignItems.Center" Class="mb-12 text-center">
                <MudText Typo="Typo.overline" Class="desa-etiket d-block">@dil.T("hizmet_sureci.etiket", "ÇALIŞMA SÜRECİ")</MudText>
                <MudText Typo="Typo.h3" Class="desa-bolum-baslik">@dil.T("hizmet_sureci.baslik", "Nasıl Çalışıyoruz?")</MudText>
            </MudStack>
            <MudGrid Spacing="6">
                @foreach (var adim in _adimlar)
                {
                    <MudItem xs="12" sm="6" md="3" Class="gsap-fade-up">
                        <div class="text-center pa-6 hover-lift" style="border: 1px solid var(--desa-border); min-height: 240px;">
                            <div style="width: 56px; height: 56px; background: var(--desa-accent); color: white; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; font-family: var(--desa-font-serif); font-size: 1.5rem;">@adim.AdimNo</div>
                            <MudText Typo="Typo.h6" Class="mb-3" Style="font-family: var(--desa-font-serif);">@adim.Baslik</MudText>
                            <MudText Typo="Typo.body2" Style="color: var(--desa-text-muted);">@adim.Aciklama</MudText>
                        </div>
                    </MudItem>
                }
            </MudGrid>
        </MudContainer>
    </MudPaper>
}

