@page "/urunler"

<PageTitle>@dil.T("urunler.baslik", "Ürünlerimiz") — DesaDoor</PageTitle>
<HeadContent>
    <meta name="description" content="@dil.T("urunler.seo_aciklama", "DesaDoor ürünlerini keşfedin. Kapı, kapak ve mobilya sistemleri için geniş ürün yelpazemizi inceleyin.")" />
</HeadContent>

<Desadoor.UI.Bilesenler.HeroSlider SayfaKodu="urunler" />

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-8">
    <MudText Typo="Typo.h3" Class="mb-6">
        @dil.T("urunler.baslik", "Ürünlerimiz")
    </MudText>

    <MudPaper Elevation="1" Class="pa-4 mb-6 d-flex flex-wrap gap-4 align-center">
        <div class="filter-select-wrapper">
            <MudSelect T="int?" Label="@dil.T("urunler.urunAilesi", "Ürün Ailesi")"
                       Clearable="true"
                       Value="_seciliUrunAilesiId"
                       ValueChanged="@UrunAilesiDegisti"
                       Variant="Variant.Outlined"
                       AnchorOrigin="Origin.BottomCenter">
                @foreach (var aile in _urunAileleri)
                {
                    <MudSelectItem Value="aile.Id">@aile.Ad</MudSelectItem>
                }
            </MudSelect>
        </div>
        <div class="filter-select-wrapper">
            <MudSelect T="int?" Label="@dil.T("urunler.kategori", "Kategori")"
                       Clearable="true"
                       Value="_seciliKategoriId"
                       ValueChanged="@KategoriDegisti"
                       Variant="Variant.Outlined"
                       AnchorOrigin="Origin.BottomCenter">
                @foreach (var kat in _kategoriler)
                {
                    <MudSelectItem Value="kat.Id">@kat.Ad</MudSelectItem>
                }
            </MudSelect>
        </div>
        <div class="filter-search-wrapper">
            <MudTextField T="string" Label="@dil.T("urunler.arama", "Ürün ara...")"
                          Value="_arama"
                          ValueChanged="@AramaDegisti"
                          Immediate="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Variant="Variant.Outlined" />
        </div>
    </MudPaper>

    @if (!string.IsNullOrEmpty(_hataMesaji))
    {
        <MudAlert Severity="Severity.Error" Class="my-4">
            @dil.T("urunler.hata", "Ürünler yüklenirken bir hata oluştu.") @_hataMesaji
        </MudAlert>
    }

    @if (_yukleniyor)
    {
        <MudProgressLinear Indeterminate="true" Class="my-8" />
    }
    else if (!_urunler.Any())
    {
        <MudAlert Severity="Severity.Info" Class="my-4">
            @dil.T("urunler.urunYok", "Henüz ürün eklenmedi.")
        </MudAlert>

        <MudCard Elevation="2" Class="mt-4 mb-6">
            <MudCardContent>
                <MudGrid>
                    <MudItem xs="12" md="6" Class="d-flex flex-column justify-center">
                        <MudText Typo="Typo.h5" Class="mb-3">
                            @dil.T("urunler.demoBaslik", "PIEDRA Banyo Konfigüratörü")
                        </MudText>
                        <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-4">
                            @dil.T("urunler.demoAciklama", "3D banyo dolabı konfigüratörümüzü hemen deneyin. Parça seçin, malzeme ve renk uygulayın, sonucu gerçek zamanlı görün.")
                        </MudText>
                        <div>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                                       Href="/vitrin/piedra"
                                       StartIcon="@Icons.Material.Filled.ViewInAr">
                                @dil.T("urunler.konfiguratorDene", "3D Konfigüratörü Dene")
                            </MudButton>
                        </div>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudImage Src="/medya/katalog/503/503-y.png" Alt='@dil.T("urunler.demoGorselAlt", "PIEDRA Konfigurator")' ObjectFit="ObjectFit.Cover" Class="rounded-lg" Elevation="2" />
                    </MudItem>
                </MudGrid>
            </MudCardContent>
        </MudCard>
    }
    else
    {
        <MudGrid>
            @foreach (var urun in SayfaliUrunler())
            {
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <UrunListeKart Urun="urun" OnClick="@(() => PopupAc(urun))" />
                </MudItem>
            }
        </MudGrid>

        @if (_toplamSayfa > 1)
        {
            <div class="d-flex justify-center mt-6">
                <MudPagination Selected="_sayfa" SelectedChanged="@SayfaDegisti" Count="_toplamSayfa" />
            </div>
        }
    }
</MudContainer>
