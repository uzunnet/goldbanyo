@page "/bayiler"
@layout DesaDoorDuzen
@using Desadoor.Ortak.Modeller

@* Bayiler — DesaDoor yetkili satış noktaları. *@

<PageTitle>@_sayfaBasligi</PageTitle>

<Desadoor.UI.Bilesenler.HeroSlider SayfaKodu="bayiler" />

<MudPaper Elevation="0" Square="true" Class="desa-bolum-acik">
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="px-6">
        <MudText Typo="Typo.overline" Class="desa-etiket mb-2 d-block text-center">@dil.T("bayiler.etiket", "YETKİLİ SATIŞ NOKTALARI")</MudText>
        <MudText Typo="Typo.h3" Class="desa-bolum-baslik mb-8 text-center">@dil.T("bayiler.baslik", "Bayilerimiz")</MudText>

        @if (_yukleniyor)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-8" />
        }
        else if (!_bayiler.Any())
        {
            <MudAlert Severity="Severity.Info" Class="my-4 text-center">@dil.T("bayiler.henuzYok", "Henüz bayi kaydı eklenmedi.")</MudAlert>
        }
        else
        {
            <MudGrid Spacing="4">
                @foreach (var bayi in _bayiler)
                {
                    <MudItem xs="12" sm="6" md="4" Class="anim-scroll-yukari">
                        <MudCard Elevation="0" Class="desa-bayi-kart">
                            <MudCardContent>
                                <MudText Typo="Typo.h6" Class="mb-2">@bayi.Ad</MudText>
                                @if (!string.IsNullOrEmpty(bayi.Adres))
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-1">
                                        <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" Class="mr-1" />
                                        @bayi.Adres
                                    </MudText>
                                }
                                @if (!string.IsNullOrEmpty(bayi.Telefon))
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-1">
                                        <MudIcon Icon="@Icons.Material.Filled.Phone" Size="Size.Small" Class="mr-1" />
                                        <MudLink Href="@($"tel:{bayi.Telefon}")">@bayi.Telefon</MudLink>
                                    </MudText>
                                }
                                @if (!string.IsNullOrEmpty(bayi.Eposta))
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-1">
                                        <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" Class="mr-1" />
                                        <MudLink Href="@($"mailto:{bayi.Eposta}")">@bayi.Eposta</MudLink>
                                    </MudText>
                                }
                                @if (!string.IsNullOrEmpty(bayi.CalismaSaatleri))
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                                        <MudIcon Icon="@Icons.Material.Filled.AccessTime" Size="Size.Small" Class="mr-1" />
                                        @bayi.CalismaSaatleri
                                    </MudText>
                                }
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        }
    </MudContainer>
</MudPaper>

@* ─── BAYİ BAŞVURU ─────────────────────────────────────────────────────────── *@
<MudPaper Elevation="0" Square="true" Class="desa-bolum-beyaz">
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="px-6 text-center">
        <MudText Typo="Typo.h4" Class="desa-bolum-baslik mb-4">@dil.T("bayiler.bayiOlun", "Bayimiz Olmak İster misiniz?")</MudText>
        <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6" Style="max-width:600px;margin:0 auto;">@dil.T("bayiler.bayiAciklama", "DesaDoor ailesine katılarak kaliteli ürünlerimizi müşterilerinize sunun. Başvuru için bizimle iletişime geçin.")</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Href="/iletisim" EndIcon="@Icons.Material.Filled.ArrowForward">
            @dil.T("bayiler.basvuru", "BAŞVURU YAP")
        </MudButton>
    </MudContainer>
</MudPaper>