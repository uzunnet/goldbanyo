@page "/haber"
@layout Desadoor.UI.Layout.DesaDoorDuzen

<PageTitle>@dil.T("haber.baslik", "Haberler & Duyurular") — DesaDoor</PageTitle>

<Desadoor.UI.Bilesenler.HeroSlider SayfaKodu="haber" />

@if (_yukleniyor)
{
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-16 d-flex justify-center align-center desa-yukleniyor-alani">
        <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
    </MudContainer>
}
else
{
    <MudPaper Elevation="0" Class="desa-hero-section desa-liste-hero d-flex align-center justify-center pa-4">
        <MudStack AlignItems="AlignItems.Center" Spacing="4" Class="text-center">
            <MudText Typo="Typo.h2" Class="desa-hero-baslik">@_heroBaslik</MudText>
            <MudText Typo="Typo.subtitle1" Class="desa-hero-altbaslik desa-hero-aciklama">
                @_heroAciklama
            </MudText>
        </MudStack>
    </MudPaper>

    <MudContainer MaxWidth="MaxWidth.Large" Class="py-16">
        <MudGrid Spacing="6">
            @foreach (var yazi in _yazilar)
            {
                <MudItem Class="anim-scroll-yukari" xs="12" md="4">
                    <MudCard Elevation="0" Class="desa-Haber-kart h-100 d-flex flex-column">
                        <MudLink Href="@HaberDetayBaglantisi(yazi)" Underline="Underline.None" Class="desa-Haber-kart-gorsel">
                            <MudCardMedia Image="@HaberGorseli(yazi)" Height="220" Class="desa-Haber-gorsel" />
                        </MudLink>
                        <MudCardContent Class="flex-grow-1">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                                <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Text">@IlkEtiket(yazi)</MudChip>
                                <MudText Typo="Typo.caption" Class="desa-kart-tarih">@yazi.Tarih.ToString("dd MMM yyyy")</MudText>
                            </MudStack>
                            <MudLink Href="@HaberDetayBaglantisi(yazi)" Underline="Underline.None">
                                <MudText Typo="Typo.h6" Class="mb-3 desa-Haber-kart-baslik">@yazi.Baslik</MudText>
                            </MudLink>
                            <MudText Typo="Typo.body2" Class="desa-Haber-kart-ozet">@yazi.Ozet</MudText>
                        </MudCardContent>
                        <MudCardActions Class="px-4 pb-4">
                            <MudButton Href="@HaberDetayBaglantisi(yazi)" Variant="Variant.Text" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ArrowRightAlt">
                                @dil.T("Haber.devaminiOku", "Devamini Oku")
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    </MudContainer>
}
