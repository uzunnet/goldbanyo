@page "/admin/sayfa-duzen-ayarlari"
@layout Desadoor.UI.Layout.AdminDuzen
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject Desadoor.UI.Servisler.DilServisi dil

<PageTitle>Sayfa Düzen Ayarları — DesaDoor Admin</PageTitle>

<MudText Typo="Typo.h4" Class="mb-2">Sayfa Düzen Ayarları</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
    Her sayfa için sutun sayısı, satır sayısı ve sayfa başına ürün adedini ayarlayın.
</MudText>

@if (_yukleniyor)
{
    <MudProgressLinear Indeterminate="true" Class="mb-4" />
}
else
{
    <MudCard Elevation="2" Class="mb-4">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h6">Sayfa Düzeni Tablosu</MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Kaydet" Disabled="_kaydediliyor">
                    @if (_kaydediliyor) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                    Kaydet
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>
        <MudCardContent>
            <MudDataGrid T="SayfaDuzenAyariDto" Items="_ayarlar" Hover="true" Striped="true" Dense="true">
                <Columns>
                    <PropertyColumn Property="x => x.SayfaKodu" Title="Sayfa Kodu" Editable="false" />
                    <PropertyColumn Property="x => x.SayfaAdi" Title="Sayfa Adı" />
                    <TemplateColumn Title="Sütun (md)" Editable="true">
                        <CellTemplate>
                            <MudNumericField @bind-Value="context.Item.SutunAdet" Min="1" Max="12" Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:100px" />
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Satır" Editable="true">
                        <CellTemplate>
                            <MudNumericField @bind-Value="context.Item.SatirAdet" Min="1" Max="20" Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:100px" />
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Sayfa Başı" Editable="true">
                        <CellTemplate>
                            <MudNumericField @bind-Value="context.Item.SayfaBasinaAdet" Min="1" Max="100" Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:100px" />
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Sayfalama" Editable="true">
                        <CellTemplate>
                            <MudSwitch @bind-Value="context.Item.SayfalamaAktif" Color="Color.Primary" />
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Aktif" Editable="true">
                        <CellTemplate>
                            <MudSwitch @bind-Value="context.Item.AktifMi" Color="Color.Success" />
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
            </MudDataGrid>
        </MudCardContent>
    </MudCard>

    <MudCard Elevation="2">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h6">Önizleme Hesaplama</MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            <MudGrid Spacing="3">
                @foreach (var ayar in _ayarlar.Where(a => a.AktifMi))
                {
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudPaper Class="pa-3" Elevation="1">
                            <MudText Typo="Typo.subtitle2" Class="mb-1">@ayar.SayfaAdi</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                @ayar.SutunAdet sutun × @ayar.SatirAdet satır = @ayar.SayfaBasinaAdet ürün/sayfa
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Tertiary">
                                Sayfalama: @(ayar.SayfalamaAktif ? "Aktif" : "Pasif")
                            </MudText>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        </MudCardContent>
    </MudCard>
}
