@page "/pdf-gosterici"
@layout Desadoor.UI.Layout.DesaDoorDuzen

<PageTitle>@($"{_baslik} | DesaDoor")</PageTitle>

<main class="pdf-gosterici-sayfasi">
    <section class="pdf-gosterici-ust">
        <div>
            <MudText Typo="Typo.overline" Class="pdf-gosterici-etiket">@dil.T("pdfGosterici.etiket", "Belge Gosterici")</MudText>
            <MudText Typo="Typo.h1" Class="pdf-gosterici-baslik">@_baslik</MudText>
        </div>
        <div class="pdf-gosterici-actions">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="GeriDon">
                @dil.T("ortak.geri", "Geri")
            </MudButton>
            @if (!string.IsNullOrWhiteSpace(_pdfUrl))
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download" Href="@_pdfUrl" Target="_blank">
                    @dil.T("pdfGosterici.indir", "PDF Indir")
                </MudButton>
            }
        </div>
    </section>

    <section class="pdf-gosterici-panel">
        @if (string.IsNullOrWhiteSpace(_pdfUrl))
        {
            <div class="pdf-gosterici-bos">
                <MudIcon Icon="@Icons.Material.Filled.PictureAsPdf" />
                <MudText Typo="Typo.h5">@dil.T("pdfGosterici.dosyaYok", "PDF dosyasi bulunamadi")</MudText>
            </div>
        }
        else if (_gorselMi)
        {
            <div class="pdf-gosterici-gorsel">
                <img src="@_pdfUrl" alt="@_baslik" />
            </div>
        }
        else
        {
            <MudPdfViewer Url="@_pdfUrl" Height="calc(100vh - 220px)" />
        }
    </section>
</main>
