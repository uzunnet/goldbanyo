<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(Layout.DesaDoorDuzen)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Bulunamadı</PageTitle>
        <LayoutView Layout="@typeof(Layout.DesaDoorDuzen)">
            <p role="alert">Üzgünüz, bu adreste bir şey bulunamadı.</p>
        </LayoutView>
    </NotFound>
</Router>
