@page "/sifre-yenile"
@layout BosDuzen

<PageTitle>@Dil.T("sifreYenile.baslik", "VizitLink3D Studio — Sifre Yenileme")</PageTitle>

<div class="studio-login-scene">
    <div class="studio-login-card">
        <div class="studio-login-header">
            <MudText Typo="Typo.h4" Class="studio-login-brand">
                @Dil.T("sifreYenile.baslik", "Sifre Yenileme")
            </MudText>
        </div>

        @if (_durum == "basarili")
        {
            <MudAlert Severity="Severity.Success" Class="mt-3 mb-3">
                @Dil.T("sifreYenile.basarili", "Sifreniz basariyla yenilendi. Lutfen yeni sifrenizle giris yapin.")
            </MudAlert>
            <div class="studio-sifirla-geridon">
                <a href="/admin" class="studio-sifirla-link">
                    @Dil.T("sifreYenile.girisDon", "Giris sayfasina git")
                </a>
            </div>
        }
        else if (string.IsNullOrEmpty(_token))
        {
            <MudAlert Severity="Severity.Error" Class="mt-3 mb-3">
                @Dil.T("sifreYenile.tokenYok", "Gecersiz sifre sifirlama baglantisi. Token bulunamadi.")
            </MudAlert>
        }
        else if (_durum == "basarisiz")
        {
            <MudAlert Severity="Severity.Error" Class="mt-3 mb-3">
                @Dil.T("sifreYenile.basarisiz", "Sifre sifirlama baglantisi gecersiz veya suresi dolmus. Lutfen tekrar deneyin.")
            </MudAlert>
        }
        else
        {
            <form method="post" action="/oturum/sifre-yenile" data-enhance="false" class="studio-login-form">
                <AntiforgeryToken />
                <input type="hidden" name="token" value="@_token" />

                <MudText Typo="Typo.body2" Class="studio-login-sub mb-4">
                    @Dil.T("sifreYenile.aciklama", "Yeni sifrenizi belirleyin.")
                </MudText>

                <div class="studio-login-field">
                    <label class="studio-login-label" for="yeni-sifre">
                        @Dil.T("sifreYenile.yeniSifre", "Yeni Sifre")
                    </label>
                    <div class="studio-sifre-alani">
                        <input type="@(_sifreGorunuyor1 ? "text" : "password")" id="yeni-sifre" name="yeniSifre"
                               class="studio-login-input" required minlength="8" autocomplete="new-password"
                               placeholder="@Dil.T("sifreYenile.yeniSifreYer", "En az 8 karakter")" />
                        <button type="button" class="studio-goz-toggle" @onclick="() => _sifreGorunuyor1 = !_sifreGorunuyor1"
                                tabindex="-1" aria-label="@Dil.T("sifreYenile.sifreGoster", "Sifreyi goster/gizle")">
                            @if (_sifreGorunuyor1)
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" />
                                    <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" />
                                    <line x1="1" y1="1" x2="23" y2="23" />
                                    <path d="M14.12 14.12a3 3 0 1 1-4.24-4.24" />
                                </svg>
                            }
                            else
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg>
                            }
                        </button>
                    </div>
                </div>

                <div class="studio-login-field">
                    <label class="studio-login-label" for="yeni-sifre-tekrar">
                        @Dil.T("sifreYenile.yeniSifreTekrar", "Yeni Sifre (Tekrar)")
                    </label>
                    <div class="studio-sifre-alani">
                        <input type="@(_sifreGorunuyor2 ? "text" : "password")" id="yeni-sifre-tekrar"
                               name="yeniSifreTekrar"
                               class="studio-login-input" required minlength="8" autocomplete="new-password"
                               placeholder="@Dil.T("sifreYenile.yeniSifreTekrarYer", "Sifrenizi tekrar girin")" />
                        <button type="button" class="studio-goz-toggle" @onclick="() => _sifreGorunuyor2 = !_sifreGorunuyor2"
                                tabindex="-1" aria-label="@Dil.T("sifreYenile.sifreGoster2", "Sifreyi goster/gizle")">
                            @if (_sifreGorunuyor2)
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" />
                                    <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" />
                                    <line x1="1" y1="1" x2="23" y2="23" />
                                    <path d="M14.12 14.12a3 3 0 1 1-4.24-4.24" />
                                </svg>
                            }
                            else
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg>
                            }
                        </button>
                    </div>
                </div>

                <button type="submit" class="studio-login-btn mud-button-root mud-button mud-button-filled mud-button-primary mud-ripple">
                    <span class="mud-button-label">
                        @Dil.T("sifreYenile.buton", "SIFREYI YENILE")
                    </span>
                </button>
            </form>
        }

        <div class="studio-login-footer">
            <MudText Typo="Typo.caption" Class="studio-login-version">
                VizitLink3D Studio &copy; @DateTime.UtcNow.Year
            </MudText>
        </div>
    </div>
</div>
