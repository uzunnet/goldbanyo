@page "/admin"
@layout BosDuzen

<PageTitle>@Dil.T("giris.baslik", "VizitLink3D Studio — Giris")</PageTitle>

<div class="studio-login-scene">
    <div class="studio-login-card">
        <div class="studio-login-header">
            <MudText Typo="Typo.h4" Class="studio-login-brand">VizitLink3D Studio</MudText>
            <MudText Typo="Typo.body2" Class="studio-login-sub">
                @Dil.T("giris.altbaslik", "Yonetim paneline giris yapin")
            </MudText>
        </div>

        <form method="post" action="/oturum/giris" data-enhance="false" class="studio-login-form">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="@_returnUrl" />

            <div class="studio-login-field">
                <label class="studio-login-label" for="giris-kullanici-adi">
                    @Dil.T("giris.kullaniciAdi", "Kullanici Adi")
                </label>
                <input type="text" id="giris-kullanici-adi" name="username"
                       class="studio-login-input" required autocomplete="username"
                       placeholder="@Dil.T("giris.kullaniciAdiYer", "Kullanici adinizi girin")" />
            </div>

            <div class="studio-login-field">
                <label class="studio-login-label" for="giris-sifre">
                    @Dil.T("giris.sifre", "Sifre")
                </label>
                <div class="studio-sifre-alani">
                    <input type="@(_sifreGorunuyor ? "text" : "password")" id="giris-sifre" name="password"
                           class="studio-login-input" required autocomplete="current-password"
                           placeholder="@Dil.T("giris.sifreYer", "Sifrenizi girin")" />
                    <button type="button" class="studio-goz-toggle" @onclick="SifreGorunurlukDegistir"
                            aria-label="@Dil.T("giris.sifreGoster", "Sifreyi goster/gizle")"
                            tabindex="-1">
                        @if (_sifreGorunuyor)
                        {
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" />
                                <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" />
                                <line x1="1" y1="1" x2="23" y2="23" />
                                <path d="M14.12 14.12a3 3 0 1 1-4.24-4.24" />
                            </svg>
                        }
                        else
                        {
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                <circle cx="12" cy="12" r="3" />
                            </svg>
                        }
                    </button>
                </div>
                <div class="studio-sifirla-baglanti">
                    <a href="/sifre-sifirla" class="studio-sifirla-link">
                        @Dil.T("giris.sifremiUnuttum", "Sifremi unuttum?")
                    </a>
                </div>
            </div>

            <button type="submit" class="studio-login-btn mud-button-root mud-button mud-button-filled mud-button-primary mud-ripple">
                <span class="mud-button-label">
                    @Dil.T("giris.buton", "GIRIS YAP")
                </span>
            </button>
        </form>

        @if (!string.IsNullOrEmpty(_hataMesaji))
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_hataMesaji</MudAlert>
        }

        <div class="studio-login-footer">
            <MudText Typo="Typo.caption" Class="studio-login-version">
                VizitLink3D Studio &copy; @DateTime.UtcNow.Year — P02-B (Konfigurator 5114)
            </MudText>
        </div>
    </div>
</div>
