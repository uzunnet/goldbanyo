@page "/fabrikamiz"
@layout VizitLink3D.UI.Layout.VizitLink3DDuzen

<PageTitle>Fabrikamýz | Gold Banyo</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="py-16" Style="background:linear-gradient(135deg, var(--gb-primary-900, #1A1A27) 0%, var(--gb-primary-700, #2b2b3f) 55%, var(--gb-gold, #C8952A) 100%);">
    <MudContainer MaxWidth="MaxWidth.Large">
        <MudGrid Spacing="4" Class="align-center">
            <MudItem xs="12" md="8">
                <MudText Typo="Typo.overline" Class="mb-3" Style="letter-spacing:.18em;color:rgba(255,255,255,.72);">GOLD BANYO ÜRETÝM MERKEZÝ</MudText>
                <MudText Typo="Typo.h2" Class="mb-4" Style="color:#fff;font-weight:700;line-height:1.1;">
                    Tasarýmdan sevkiyata uzanan entegre üretim akýþý
                </MudText>
                <MudText Typo="Typo.body1" Class="mb-6" Style="color:rgba(255,255,255,.82);line-height:1.9;max-width:760px;">
                    Gold Banyo fabrikasýnda koleksiyon geliþtirme, gövde hazýrlama, yüzey uygulama, montaj ve kalite kontrol süreçleri ayný operasyon çatýsý altýnda yönetilir.
                </MudText>
                <div class="d-flex flex-wrap ga-2">
                    <MudText Typo="Typo.caption" Class="px-4 py-2" Style="color:#111;background:var(--gb-gold, #C8952A);border-radius:999px;font-weight:700;">5.000 m² Üretim Alaný</MudText>
                    <MudText Typo="Typo.caption" Class="px-4 py-2" Style="color:#fff;border:1px solid rgba(255,255,255,.28);border-radius:999px;">CNC ve panel iþleme</MudText>
                    <MudText Typo="Typo.caption" Class="px-4 py-2" Style="color:#fff;border:1px solid rgba(255,255,255,.28);border-radius:999px;">Kalite kontrol ve paketleme</MudText>
                </div>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudPaper Elevation="0" Class="pa-6" Style="background:rgba(255,255,255,.08);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,.12);border-radius:20px;">
                    <MudText Typo="Typo.overline" Style="color:rgba(255,255,255,.68);">Operasyon Özeti</MudText>
                    <MudDivider Class="my-3" Style="border-color:rgba(255,255,255,.14);" />
                    @foreach (var ist in _istatistikler.Take(4))
                    {
                        <div class="d-flex justify-space-between align-center py-2">
                            <MudText Typo="Typo.body2" Style="color:rgba(255,255,255,.7);">@ist.Etiket</MudText>
                            <MudText Typo="Typo.h6" Style="color:#fff;font-weight:700;">@ist.Deger</MudText>
                        </div>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudContainer>
</MudContainer>

@* TANITIM *@
<MudContainer MaxWidth="MaxWidth.Large" Class="py-16">
    <MudGrid Spacing="6" Class="align-center">
        <MudItem xs="12" md="6" Class="anim-scroll-yukari">
            <MudText Typo="Typo.overline" Color="Color.Primary" Class="vizit-vurgu-metin vizit-text-glow-gold mb-2">ÜRETÝM TESÝSÝ</MudText>
            <MudText Typo="Typo.h3" Class="vizit-bolum-baslik vizit-text-glow-gold mb-4">Fabrikamýz</MudText>
            <MudText Typo="Typo.body1" Class="gb-govde-metin mb-4" Style="line-height:1.9;">
                Gold Banyo üretim tesisi, <strong>5.000 m²</strong> kapalý alanda modern CNC teknolojileri, otomatik pres hatlarý ve hassas yüzey uygulama süreçleriyle banyo mobilyasý bileþenleri üretmektedir.
            </MudText>
            <MudText Typo="Typo.body1" Class="gb-govde-metin mb-6" Style="line-height:1.9;">
                Üretim deneyimimiz; Endüstri 4.0 ekipmanlarý, sürdürülebilir malzeme yaklaþýmý ve kalite odaklý operasyon modeliyle Gold Banyo koleksiyonlarýnýn sürekliliðini güvence altýna alýr.
            </MudText>
            <MudGrid Spacing="3">
                @foreach (var ist in _istatistikler)
                {
                    <MudItem xs="6">
                        <MudPaper Elevation="0" Class="pa-4 text-center" Style="background:var(--gb-bg-alt);border-radius:8px;">
                            <MudText Typo="Typo.h4" Color="Color.Primary" Class="fw-bold">@ist.Deger</MudText>
                            <MudText Typo="Typo.caption" Style="opacity:.75;">@ist.Etiket</MudText>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        </MudItem>
        <MudItem xs="12" md="6" Class="anim-scroll-yukari">
            <div style="border-radius:12px;overflow:hidden;box-shadow:0 10px 40px rgba(0,0,0,.12);">
                <img src="@Gorsel("goldbanyo/uretim.jpg")" alt="Gold Banyo üretim hattý"
                     style="width:100%;height:420px;object-fit:cover;display:block;" />
            </div>
        </MudItem>
    </MudGrid>
</MudContainer>

@* FABRIKA ICI GALERI *@
<div style="background:var(--gb-bg-alt);padding:64px 0;">
    <MudContainer MaxWidth="MaxWidth.ExtraLarge">
        <MudText Typo="Typo.overline" Color="Color.Primary" Class="vizit-vurgu-metin vizit-text-glow-gold mb-2 d-block text-center">ÜRETÝM SÜRECÝ</MudText>
        <MudText Typo="Typo.h4" Class="vizit-bolum-baslik vizit-text-glow-gold mb-8 text-center">Üretim Alanlarýmýz</MudText>
        <MudGrid Spacing="3">
            @foreach (var (gorsel, baslik, aciklama) in _uretimAlanlari)
            {
                <MudItem xs="12" sm="6" md="3" Class="anim-scroll-yukari">
                    <MudCard Elevation="2" Style="border-radius:10px;overflow:hidden;height:100%;">
                        <div style="height:220px;overflow:hidden;">
                            <img src="@Gorsel(gorsel)" alt="@baslik"
                                 style="width:100%;height:100%;object-fit:cover;transition:transform .4s;" />
                        </div>
                        <MudCardContent>
                            <MudText Typo="Typo.h6" Class="fw-bold mb-1">@baslik</MudText>
                            <MudText Typo="Typo.body2" Style="opacity:.75;line-height:1.6;">@aciklama</MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    </MudContainer>
</div>

@* TEKNOLOJILERIMIZ *@
<MudContainer MaxWidth="MaxWidth.Large" Class="py-16">
    <MudText Typo="Typo.overline" Color="Color.Primary" Class="vizit-vurgu-metin vizit-text-glow-gold mb-2 d-block text-center">ENDÜSTRÝ 4.0</MudText>
    <MudText Typo="Typo.h4" Class="vizit-bolum-baslik vizit-text-glow-gold mb-10 text-center">Teknoloji Altyapýmýz</MudText>
    <MudGrid Spacing="4">
        @foreach (var (ikon, baslik, aciklama) in _teknolojiler)
        {
            <MudItem xs="12" sm="6" md="4" Class="anim-scroll-yukari">
                <MudPaper Elevation="0" Class="pa-6 d-flex flex-column align-center text-center"
                          Style="border:1px solid var(--mud-palette-divider);border-radius:10px;height:100%;">
                    <MudIcon Icon="@ikon" Color="Color.Primary" Style="font-size:2.5rem;" Class="mb-3" />
                    <MudText Typo="Typo.h6" Class="fw-bold mb-2">@baslik</MudText>
                    <MudText Typo="Typo.body2" Style="opacity:.75;line-height:1.7;">@aciklama</MudText>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
</MudContainer>

@* KALITE BLOKU *@
<div style="background:linear-gradient(140deg, var(--gb-primary-900, #1A1A27) 0%, var(--gb-primary-800, #26263a) 55%, #111 100%);padding:72px 24px;">
    <div style="max-width:880px;margin:0 auto;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;">
        <MudText Typo="Typo.h3" Style="color:#fff;font-weight:700;">
            Kalite, her ürünün içinde baþlar
        </MudText>
        <MudText Typo="Typo.subtitle1" Style="color:rgba(255,255,255,.85);max-width:680px;margin-top:12px;line-height:1.8;">
            Hammadde seçiminden panel iþlemeye, yüzey hazýrlýðýndan paketlemeye kadar her istasyon standart kontrol listeleriyle takip edilir.
        </MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Href="/iletisim"
                   Class="mt-6" Size="Size.Large">
            Fabrikamýzý Ziyaret Edin
        </MudButton>
    </div>
</div>

@* URETIM GALERISI *@
<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-16">
    <MudText Typo="Typo.overline" Color="Color.Primary" Class="vizit-vurgu-metin vizit-text-glow-gold mb-2 d-block text-center">GALERÝ</MudText>
    <MudText Typo="Typo.h4" Class="vizit-bolum-baslik vizit-text-glow-gold mb-8 text-center">Üretim Galerimiz</MudText>
    <MudGrid Spacing="2">
        @foreach (var gorsel in _uretimGalerisi)
        {
            <MudItem xs="12" sm="6" md="@gorsel.Kolon" Class="anim-scroll-yukari">
                <div style="border-radius:8px;overflow:hidden;height:@gorsel.Yukseklik;">
                    <img src="@Gorsel(gorsel.DosyaYolu)" alt="@gorsel.AltMetin"
                         style="width:100%;height:100%;object-fit:cover;transition:transform .4s;display:block;" />
                </div>
            </MudItem>
        }
    </MudGrid>
</MudContainer>

