@page "/sertifikalar"
@layout VizitLink3D.UI.Layout.VizitLink3DDuzen

<PageTitle>@($"{dil.T("sertifikalar.sayfaBasligi", "Sertifikalar")} | Gold Banyo")</PageTitle>

<main class="sertifikalar-sayfasi">
    <VizitLink3D.UI.Bilesenler.HeroSlider SayfaKodu="sertifikalar" />

    <section class="sertifikalar-liste-bolumu">
        @if (_yukleniyor)
        {
            <div class="sertifikalar-grid">
                @for (var i = 0; i < 6; i++)
                {
                    <MudSkeleton Class="sertifika-kart sertifika-kart--iskelet" />
                }
            </div>
        }
        else if (_sertifikalar.Count == 0)
        {
            <div class="sertifikalar-bos">
                <MudIcon Icon="@Icons.Material.Filled.Verified" />
                <MudText Typo="Typo.h5">@dil.T("sertifikalar.bosBaslik", "Sertifika bulunamadi")</MudText>
                <MudText Typo="Typo.body2">@dil.T("sertifikalar.bosAciklama", "Yayina alinmis sertifika oldugunda bu alanda listelenecek.")</MudText>
            </div>
        }
        else
        {
            <div class="sertifikalar-grid">
                @foreach (var sertifika in _sertifikalar)
                {
                    <article class="sertifika-kart">
                        <div class="sertifika-kart__onizleme">
                            @if (!string.IsNullOrWhiteSpace(OnizlemeUrl(sertifika)))
                            {
                                <img src="@OnizlemeUrl(sertifika)" alt="@sertifika.Ad" loading="lazy" />
                            }
                            else
                            {
                                <div class="sertifika-kart__pdf">
                                    <MudIcon Icon="@Icons.Material.Filled.PictureAsPdf" />
                                    <span>@dil.T("sertifikalar.pdfBelge", "PDF Belge")</span>
                                </div>
                            }
                        </div>

                        <div class="sertifika-kart__govde">
                            <MudText Typo="Typo.overline" Class="sertifika-kart__kurum">@(!string.IsNullOrWhiteSpace(sertifika.VerenKurum) ? sertifika.VerenKurum : dil.T("sertifikalar.kurumYok", "Belgelendirme"))</MudText>
                            <MudText Typo="Typo.h5" Class="sertifika-kart__baslik">@sertifika.Ad</MudText>
                            @if (!string.IsNullOrWhiteSpace(sertifika.Aciklama))
                            {
                                <MudText Typo="Typo.body2" Class="sertifika-kart__aciklama">@sertifika.Aciklama</MudText>
                            }

                            <div class="sertifika-kart__alt">
                                <span>@TarihMetni(sertifika)</span>
                                @if (!string.IsNullOrWhiteSpace(BelgeYolu(sertifika)))
                                {
                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               Href="@PdfGostericiUrl(sertifika)"
                                               StartIcon="@Icons.Material.Filled.OpenInNew">
                                        @dil.T("sertifikalar.goruntule", "Goruntule")
                                    </MudButton>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </section>
</main>
