@page "/katalog"
@layout VizitLink3DDuzen

<PageTitle>@Dil.T("katalog.sayfaBasligi", "Kataloglar & Yayinlar | VizitLink3D")</PageTitle>

<main class="katalog-sayfasi">
    <VizitLink3D.UI.Bilesenler.HeroSlider SayfaKodu="katalog" />

    <section class="katalog-liste-bolumu">
        @if (_yukleniyor)
        {
            <div class="katalog-grid">
                @for (var i = 0; i < 3; i++)
                {
                    <MudSkeleton Class="katalog-kart katalog-kart--iskelet" />
                }
            </div>
        }
        else if (!_kataloglar.Any())
        {
            <div class="katalog-bos">
                <MudIcon Icon="@Icons.Material.Outlined.FolderOpen" />
                <MudText Typo="Typo.h5">@Dil.T("katalog.bulunamadi", "Aktif katalog bulunamadi.")</MudText>
            </div>
        }
        else
        {
            <div class="katalog-grid">
                @foreach (var katalog in _kataloglar)
                {
                    <article class="katalog-kart">
                        <div class="katalog-kart__onizleme">
                            <img src="@OnizlemeUrl(katalog)" alt="@katalog.Baslik" loading="lazy" />
                            <span class="katalog-kart__yil">@(katalog.Yil?.ToString() ?? DateTime.UtcNow.Year.ToString())</span>
                        </div>

                        <div class="katalog-kart__govde">
                            <MudText Typo="Typo.h5" Class="katalog-kart__baslik">@katalog.Baslik</MudText>
                            @if (!string.IsNullOrWhiteSpace(katalog.Aciklama))
                            {
                                <MudText Typo="Typo.body2" Class="katalog-kart__aciklama">@katalog.Aciklama</MudText>
                            }

                            <div class="katalog-kart__meta">
                                @if (katalog.SayfaSayisi.HasValue && katalog.SayfaSayisi.Value > 0)
                                {
                                    <span>
                                        <MudIcon Icon="@Icons.Material.Outlined.MenuBook" Size="Size.Small" />
                                        @katalog.SayfaSayisi.Value @Dil.T("katalog.sayfaSayisi", "Sayfa")
                                    </span>
                                }
                                @if (katalog.DosyaBoyutuMb.HasValue && katalog.DosyaBoyutuMb.Value > 0)
                                {
                                    <span>
                                        <MudIcon Icon="@Icons.Material.Outlined.Save" Size="Size.Small" />
                                        @katalog.DosyaBoyutuMb.Value.ToString("N1") MB
                                    </span>
                                }
                            </div>

                            <div class="katalog-kart__aksiyonlar">
                                <MudButton Href="@PdfGostericiUrl(katalog)"
                                           Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.RemoveRedEye">
                                    @Dil.T("katalog.incele", "Incele")
                                </MudButton>
                                <MudIconButton Href="@IndirUrl(katalog)"
                                               Target="_blank"
                                               Icon="@Icons.Material.Filled.Download"
                                               Color="Color.Primary"
                                               Variant="Variant.Outlined" />
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </section>
</main>
