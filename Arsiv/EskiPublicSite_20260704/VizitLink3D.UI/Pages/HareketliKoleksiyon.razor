@page "/hareketli-koleksiyon"
@layout VizitLink3DDuzen

@* Hareketli Koleksiyon — Aurelian Onyx, Stitch 7455b29e *@

<PageTitle>@dil.T("hareketli.koleksiyon.baslik", "Hareketli Koleksiyon — Gold Banyo")</PageTitle>

<div class="vizit-bg-primary-container">

    <section class="stitch-hero" style="min-height:60vh">
        <div class="stitch-hero__overlay"></div>
        <div class="stitch-hero__icerik">
            <span class="stitch-hero__ust-baslik anim-reveal-up">@dil.T("hareketli.ustbaslik", "SLIDING COLLECTION")</span>
            <h1 class="stitch-hero__baslik anim-reveal-up" style="animation-delay:0.1s">@dil.T("hareketli.baslik", "Hareketli Koleksiyon")</h1>
            <p class="stitch-hero__aciklama anim-reveal-up" style="animation-delay:0.2s">@dil.T("hareketli.aciklama", "Yumuşak kapanma teknolojisi ve sessiz ray sistemleriyle modern banyolar için akıcı çözümler.")</p>
        </div>
    </section>

    <section class="vizit-section">
        <div class="vizit-section-icerik">
            <div class="vizit-bolum-baslik-kutu">
                <h2 class="vizit-bolum-baslik">@dil.T("hareketli.urunler", "Hareketli Ürünler")</h2>
            </div>

            @if (_yukleniyor)
            {
                <MudProgressCircular Indeterminate="true" Class="my-8" />
            }
            else if (_urunler.Count == 0)
            {
                <MudText Typo="Typo.body1" Class="my-8">@dil.T("hareketli.bos", "Henüz hareketli koleksiyon ürünü eklenmemiş.")</MudText>
            }
            else
            {
                <div class="stitch-urun-grid">
                    @foreach (var urun in _urunler)
                    {
                        <StitchUrunKart Urun="urun" OnClick="UrunDetayaGit" />
                    }
                </div>
            }
        </div>
    </section>

</div>
