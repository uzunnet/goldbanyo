@page "/kapak-sistemleri"
@layout VizitLink3DDuzen

<PageTitle>@_sayfaBasligi</PageTitle>

<VizitLink3D.UI.Bilesenler.HeroSlider SayfaKodu="@(_aktifModelTuru == "Kapi" ? "kapi-modelleri" : "kapak-sistemleri")" />

<MudPaper Elevation="1" Square="true" Class="gb-kapak-filtre-cubugu">
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="px-6 py-4">
        <MudStack Row="true" Spacing="4" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                @foreach (var kat in _kategoriler)
                {
                    <MudChip T="string"
                             Text="@kat"
                             Variant="@(_secilenKategori == kat ? Variant.Filled : Variant.Outlined)"
                             Color="@(_secilenKategori == kat ? Color.Dark : Color.Default)"
                             Size="Size.Small"
                             OnClick="@(() => KategoriSec(kat))"
                             Class="gb-kategori-chip" />
                }
            </MudStack>

            <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center">
                <MudTextField Value="_aramaMetni"
                              ValueChanged="@((string v) => AramaYap(v))"
                              Placeholder="@dil.T("kapi.modelAra", "Model ara...")"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Outlined.Search"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="gb-arama-alani" />
                <MudSelect Value="_siralama"
                           ValueChanged="@((string v) => SiralamaDegistir(v))"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Class="gb-siralama-alani">
                    <MudSelectItem Value="@("yeni")">@dil.T("kapi.yenilerOnce", "Yeniler Önce")</MudSelectItem>
                    <MudSelectItem Value="@("one_cikan")">@dil.T("kapi.oneCikanlar", "Öne Çıkanlar")</MudSelectItem>
                    <MudSelectItem Value="@("isme_gore")">@dil.T("kapi.ismeGore", "İsme Göre")</MudSelectItem>
                </MudSelect>
            </MudStack>
        </MudStack>
    </MudContainer>
</MudPaper>

<MudPaper Elevation="0" Square="true" Class="gb-kapak-liste-bolum">
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="px-6">
        @if (_yukleniyor)
        {
            <MudGrid Spacing="4">
                @for (int i = 0; i < _sayfaBasinaAdet; i++)
                {
                    <MudItem xs="12" sm="6" md="@MudItemMd" lg="@MudItemLg">
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="320px" Class="mb-2" />
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="60%" Height="16px" Class="mb-1" />
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="40%" Height="14px" />
                    </MudItem>
                }
            </MudGrid>
        }
        else if (!_filtrelenmisKapaklar.Any())
        {
            <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="gb-bos-liste">
                <MudIcon Icon="@Icons.Material.Outlined.SearchOff" Size="Size.Large" Color="Color.Secondary" />
                <MudText Typo="Typo.h6">@dil.T("kapi.aramaBulunamadi", "Arama kriterine uygun model bulunamadı.")</MudText>
                <MudButton Variant="Variant.Outlined" Class="vizit-btn-ikincil vizit-text-glow-gold vizit-border-glow" OnClick="@(() => { _aramaMetni = ""; _secilenKategori = "Tümü"; _aktifSayfa = 1; })">
                    @dil.T("kapi.filtreTemizle", "Filtreleri Temizle")
                </MudButton>
            </MudStack>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="gb-liste-sayaci mb-6">
                @_toplamUrun @dil.T("kapi.modelGosteriliyor", "model gösteriliyor")
                — @dil.T("kapi.sayfa", "Sayfa") @_aktifSayfa / @_toplamSayfa
            </MudText>

            <MudGrid Spacing="4">
                @foreach (var kapak in _filtrelenmisKapaklar)
                {
                    <MudItem xs="12" sm="6" md="@MudItemMd" lg="@MudItemLg" @key="kapak.Id" Class="anim-scroll-yukari gb-anim-fade-up">
                        <article class="vizit-glass-card vizit-border-glow" @onclick="@(() => KapakAc(kapak))">
                            <div class="gb-kapak-gorsel-kutu">
                                <img src="@GetDetayliGorsel(kapak)"
                                     alt="@kapak.ModelAdi"
                                     class="gb-kapak-gorsel"
                                     style="width: 100%; height: 100%; object-fit: cover; padding: 0; box-sizing: border-box;"
                                     loading="lazy" onerror="this.onerror=null;this.src='/medya/vizitlink3d_default.png';" />
                                <div class="gb-kapak-rozetler">
                                    @if (kapak.YeniMi)
                                    {
                                        <span>@dil.T("kapi.yeni", "YENİ")</span>
                                    }
                                    @if (kapak.OneCikanMi)
                                    {
                                        <span>@dil.T("kapi.oncu", "ÖNCÜ")</span>
                                    }
                                </div>
                            </div>
                            <div class="gb-kapak-bilgi">
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Class="mb-1">
                                    <MudText Typo="Typo.subtitle1" Class="gb-kapak-ad">@kapak.ModelAdi</MudText>
                                    <MudText Typo="Typo.caption" Class="gb-kapak-kod">@kapak.ModelKodu</MudText>
                                </MudStack>
                                <MudText Typo="Typo.body2" Class="gb-kapak-kategori">@kapak.Kategori</MudText>
                            </div>
                        </article>
                    </MudItem>
                }
            </MudGrid>

            @if (_sayfalamaAktif && _toplamSayfa > 1)
            {
                <MudStack Row="true" Justify="Justify.Center" AlignItems="AlignItems.Center" Class="mt-8 mb-4" Spacing="2">
                    <MudButton Variant="Variant.Outlined"
                               Disabled="@(_aktifSayfa <= 1)"
                               OnClick="@(() => SayfaDegistir(_aktifSayfa - 1))"
                               StartIcon="@Icons.Material.Outlined.ChevronLeft">
                        @dil.T("kapi.onceki", "Önceki")
                    </MudButton>

                    @for (int i = 1; i <= _toplamSayfa; i++)
                    {
                        var sayfaNo = i;
                        <MudButton Variant="@(_aktifSayfa == sayfaNo ? Variant.Filled : Variant.Outlined)"
                                   Color="@(_aktifSayfa == sayfaNo ? Color.Dark : Color.Default)"
                                   OnClick="@(() => SayfaDegistir(sayfaNo))"
                                   Class="vizit-btn-ikincil vizit-border-glow">
                            @sayfaNo
                        </MudButton>
                    }

                    <MudButton Variant="Variant.Outlined"
                               Disabled="@(_aktifSayfa >= _toplamSayfa)"
                               OnClick="@(() => SayfaDegistir(_aktifSayfa + 1))"
                               EndIcon="@Icons.Material.Outlined.ChevronRight">
                        @dil.T("kapi.sonraki", "Sonraki")
                    </MudButton>
                </MudStack>
            }
        }
    </MudContainer>
</MudPaper>

@if (!_yukleniyor && _cokIzlenenler.Any())
{
    <MudPaper Elevation="0" Square="true" Class="gb-kapak-populer-bolum">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="px-6">
            <MudText Typo="Typo.overline" Class="vizit-vurgu-metin vizit-text-glow-gold mb-3 d-block">
                @dil.T("kapi.cokIzlenenler", "ÇOK İZLENENLER")
            </MudText>
            <MudText Typo="Typo.h3" Class="vizit-bolum-baslik vizit-text-glow-gold mb-6">
                @dil.T("kapi.musteriDikkatiniCekenler", "Müşterilerin Dikkatini Çekenler")
            </MudText>
            <MudGrid Spacing="4">
                @foreach (var kapak in _cokIzlenenler)
                {
                    <MudItem xs="12" sm="6" md="3" @key="kapak.Id">
                        <NavLink href="@DetayUrl(kapak)" class="gb-kapak-populer-kart">
                            <img src="@GetDetayliGorsel(kapak)" alt="@kapak.ModelAdi" loading="lazy" style="width: 100%; height: 100%; object-fit: cover; padding: 0; border-radius: 8px; box-sizing: border-box;" onerror="this.onerror=null;this.src='/medya/vizitlink3d_default.png';" />
                            <span>@kapak.ModelKodu</span>
                            <strong>@kapak.ModelAdi</strong>
                        </NavLink>
                    </MudItem>
                }
            </MudGrid>
        </MudContainer>
    </MudPaper>
}

