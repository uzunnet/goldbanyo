@page "/sss"
@layout VizitLink3DDuzen

<PageTitle>@dil.T("sss.baslik", "Sıkça Sorulan Sorular") — Gold Banyo</PageTitle>

<VizitLink3D.UI.Bilesenler.HeroSlider SayfaKodu="sss" />

@if (_yukleniyor)
{
    <MudContainer MaxWidth="MaxWidth.Large" Class="py-16 d-flex justify-center align-center" Style="min-height: 60vh;">
        <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
    </MudContainer>
}
else
{
    <MudPaper Elevation="0" Square="true" Style="min-height: 35vh; background-color: var(--gb-secondary); color: var(--gb-bg-base); display: flex; align-items: center; justify-content: center; padding: 64px 0;">
        <MudStack AlignItems="AlignItems.Center" Spacing="4" Class="text-center">
            <MudText Typo="Typo.h2" Style="color: var(--gb-bg-base); font-family: 'Noto Serif', serif;">@_heroBaslik</MudText>
        </MudStack>
    </MudPaper>

    <MudContainer MaxWidth="MaxWidth.Large" Class="py-16">
        @if (_sorular.Any())
        {
            <MudExpansionPanels Elevation="0" Class="gb-sss-panel">
                @foreach (var soru in _sorular)
                {
                    <MudExpansionPanel Text="@soru.Soru" Style="border-bottom: 1px solid var(--gb-border); margin-bottom: 8px;">
                        <MudText Typo="Typo.body1" Style="color: var(--gb-secondary); line-height: 1.8; padding: 8px 0;">@soru.Cevap</MudText>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        }
        else
        {
            <MudText Typo="Typo.body1" Class="text-center" Style="color: var(--gb-secondary);">@dil.T("sss.icerikYok", "Henuz SSS icerigi eklenmemistir.")</MudText>
        }
    </MudContainer>
}
