@page "/hakkimizda"
@layout VizitLink3D.UI.Layout.VizitLink3DDuzen

<PageTitle>@_sayfaBasligi</PageTitle>

@if (_yukleniyor)
{
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="gold-hakkimizda-yukleniyor">
        <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
    </MudContainer>
}
else
{
    <div class="vizit-bg-primary-container">
        <VizitLink3D.UI.Bilesenler.HeroSlider SayfaKodu="hakkimizda" />

        <section class="py-12">
            <MudContainer MaxWidth="MaxWidth.ExtraLarge">
                <MudGrid Spacing="6" Class="align-center">
                    <MudItem xs="12" lg="6" Class="anim-scroll-yukari">
                        <div class="vizit-glass-card pa-6">
                            <MudText Typo="Typo.overline" Style="color: var(--vizit-text-muted);">@_kurumsalEtiket</MudText>
                            <h2>@_heroBaslik</h2>
                            <p>@_heroAciklama</p>
                            @if (!string.IsNullOrWhiteSpace(_pdfKatalogUrl))
                            {
                                <MudButton Href="@KatalogPdfGostericiUrl()"
                                           Variant="Variant.Outlined"
                                           Style="color: var(--vizit-gold); border-color: var(--vizit-gold);"
                                           StartIcon="@Icons.Material.Filled.AutoStories"
                                           Class="mt-4">
                                    @_katalogButonYazi
                                </MudButton>
                            }
                        </div>
                    </MudItem>
                    <MudItem xs="12" lg="6" Class="anim-scroll-yukari">
                        <div style="border: 1px solid var(--vizit-border); padding: 10px; background: var(--vizit-surface);">
                            @if (!string.IsNullOrWhiteSpace(_youtubeUrl))
                            {
                                <iframe src="@_youtubeUrl"
                                        style="width: 100%; aspect-ratio: 16/9; border: none;"
                                        allowfullscreen></iframe>
                            }
                            else if (!string.IsNullOrWhiteSpace(_videoUrl))
                            {
                                <video style="width: 100%; aspect-ratio: 16/9;" controls autoplay loop muted>
                                    <source src="@_videoUrl" type="video/mp4" />
                                    @dil.T("video.unsupported", "Tarayıcınız video etiketini desteklemiyor.")
                                </video>
                            }
                            else
                            {
                                <img src="@HakkimizdaGorselTamUrl()" alt="@_heroBaslik" style="width: 100%; height: auto; object-fit: cover;" />
                            }
                        </div>
                    </MudItem>
                </MudGrid>
            </MudContainer>
        </section>

        <section class="py-12" style="background-color: var(--vizit-bg-alt);">
            <MudContainer MaxWidth="MaxWidth.ExtraLarge">
                <MudGrid Spacing="6">
                    <MudItem xs="12" lg="7" Class="anim-scroll-yukari">
                        <MudText Typo="Typo.overline" Style="color: var(--vizit-gold);">
                            @dil.T("hakkimizda.etiket", "Kurumsal")
                        </MudText>
                        <h3 style="font-family: var(--vizit-font-serif); color: var(--vizit-text); margin-bottom: 1.5rem; font-size: 2rem;">@_hikayeBasligi</h3>
                        <div>
                            @foreach (var paragraf in HikayeParagraflari)
                            {
                                <p style="color: var(--vizit-text-secondary); line-height: 1.8; margin-bottom: 1rem;">@paragraf</p>
                            }
                        </div>
                    </MudItem>
                    <MudItem xs="12" lg="5" Class="anim-scroll-yukari">
                        <MudStack Spacing="4">
                            <div class="vizit-glass-card pa-6">
                                <h3>@dil.T("hakkimizda.misyonBaslik", "Misyonumuz")</h3>
                                <p>@_misyon</p>
                            </div>
                            <div class="vizit-glass-card pa-6">
                                <h3>@dil.T("hakkimizda.vizyonBaslik", "Vizyonumuz")</h3>
                                <p>@_vizyon</p>
                            </div>
                        </MudStack>
                    </MudItem>
                </MudGrid>
            </MudContainer>
        </section>

        <section class="py-12" style="border-top: 1px solid var(--vizit-border); border-bottom: 1px solid var(--vizit-border);">
            <MudContainer MaxWidth="MaxWidth.Large">
                <MudGrid Spacing="4" Justify="Justify.Center">
                    <MudItem xs="6" sm="3" Class="anim-scroll-yukari text-center">
                        <h2 style="font-family: var(--vizit-font-serif); color: var(--vizit-gold); font-size: 3rem;">@_yilTecrube</h2>
                        <p style="color: var(--vizit-text-muted); text-transform: uppercase; letter-spacing: 1px;">
                            @dil.T("hakkimizda.yilTecrubeEtiket", "Yıl Tecrübe")
                        </p>
                    </MudItem>
                    <MudItem xs="6" sm="3" Class="anim-scroll-yukari text-center">
                        <h2 style="font-family: var(--vizit-font-serif); color: var(--vizit-gold); font-size: 3rem;">@_tamamlananProje</h2>
                        <p style="color: var(--vizit-text-muted); text-transform: uppercase; letter-spacing: 1px;">
                            @dil.T("hakkimizda.tamamlananProjeEtiket", "Tamamlanan Proje")
                        </p>
                    </MudItem>
                    <MudItem xs="6" sm="3" Class="anim-scroll-yukari text-center">
                        <h2 style="font-family: var(--vizit-font-serif); color: var(--vizit-gold); font-size: 3rem;">@_bayiSayisi</h2>
                        <p style="color: var(--vizit-text-muted); text-transform: uppercase; letter-spacing: 1px;">
                            @dil.T("hakkimizda.aktifBayiEtiket", "Aktif Bayi")
                        </p>
                    </MudItem>
                    <MudItem xs="6" sm="3" Class="anim-scroll-yukari text-center">
                        <h2 style="font-family: var(--vizit-font-serif); color: var(--vizit-gold); font-size: 3rem;">@_personelSayisi</h2>
                        <p style="color: var(--vizit-text-muted); text-transform: uppercase; letter-spacing: 1px;">
                            @dil.T("hakkimizda.uzmanPersonelEtiket", "Uzman Personel")
                        </p>
                    </MudItem>
                </MudGrid>
            </MudContainer>
        </section>

        <section class="py-12">
            <MudContainer MaxWidth="MaxWidth.Large">
                <h3 style="font-family: var(--vizit-font-serif); color: var(--vizit-gold); text-align: center; margin-bottom: 3rem; font-size: 2.5rem; text-transform: uppercase;">
                    @dil.T("hakkimizda.kilometreTaslari", "Kilometre Taşlarımız")
                </h3>
                <MudTimeline TimelinePosition="TimelinePosition.Alternate">
                    @foreach (var an in _tarihsel)
                    {
                        <MudTimelineItem Color="Color.Dark" Size="Size.Small">
                            <ItemOpposite>
                                <MudText Typo="Typo.h5" Style="color: var(--vizit-gold); font-family: var(--vizit-font-serif);">@an.Yil</MudText>
                            </ItemOpposite>
                            <ItemContent>
                                <div class="vizit-glass-card" style="padding: 1.5rem;">
                                    <h3 style="margin-bottom: 0.5rem; font-size: 1.2rem;">@an.Baslik</h3>
                                    <p style="margin-bottom: 0;">@an.Aciklama</p>
                                </div>
                            </ItemContent>
                        </MudTimelineItem>
                    }
                </MudTimeline>
            </MudContainer>
        </section>

        @if (_ekipUyeleri.Any())
        {
            <section class="py-12" style="background-color: var(--vizit-bg-alt);">
                <MudContainer MaxWidth="MaxWidth.Large">
                    <div style="text-align: center; margin-bottom: 3rem;">
                        <MudText Typo="Typo.overline" Style="color: var(--vizit-text-muted);">
                            @dil.T("hakkimizda.ekibimizEtiket", "EKİBİMİZİ DAHA YAKINDAN TANIYIN")
                        </MudText>
                        <h3 style="font-family: var(--vizit-font-serif); color: var(--vizit-gold); font-size: 2.5rem; text-transform: uppercase;">
                            @dil.T("hakkimizda.ekibimizBaslik", "Ekibimiz")
                        </h3>
                    </div>
                    <MudGrid Spacing="6" Justify="Justify.Center">
                        @foreach (var uye in _ekipUyeleri)
                        {
                            <MudItem xs="12" sm="6" md="3">
                                <div class="anim-scroll-yukari" style="text-align: center;">
                                    <div style="width: 100%; aspect-ratio: 1/1; overflow: hidden; border: 1px solid var(--vizit-border); margin-bottom: 1rem;">
                                        <img src="@EkipResimUrl(uye.Resim)" alt="@uye.AdSoyad" style="width: 100%; height: 100%; object-fit: cover; filter: grayscale(100%); transition: var(--vizit-transition);" onmouseover="this.style.filter='none'" onmouseout="this.style.filter='grayscale(100%)'" />
                                    </div>
                                    <MudText Typo="Typo.subtitle1" Style="color: var(--vizit-text); font-weight: 600;">@uye.AdSoyad</MudText>
                                    <MudText Typo="Typo.body2" Style="color: var(--vizit-gold);">@uye.Unvan</MudText>
                                </div>
                            </MudItem>
                        }
                    </MudGrid>
                </MudContainer>
            </section>
        }
    </div>
}
