@page "/akilli-koleksiyon"
@layout VizitLink3DDuzen

@* Akıllı Koleksiyon — Aurelian Onyx, Stitch 6b679797 *@

<PageTitle>@dil.T("akilli.koleksiyon.baslik", "Akıllı Koleksiyon — Gold Banyo")</PageTitle>

<div class="vizit-bg-primary-container">

    <section class="stitch-hero" style="min-height:50vh">
        <div class="stitch-hero__overlay"></div>
        <div class="stitch-hero__icerik">
            <span class="stitch-hero__ust-baslik anim-reveal-up">@dil.T("akilli.ustbaslik", "SMART COLLECTION")</span>
            <h1 class="stitch-hero__baslik anim-reveal-up" style="animation-delay:0.1s">@dil.T("akilli.baslik", "Akıllı Koleksiyon")</h1>
            <p class="stitch-hero__aciklama anim-reveal-up" style="animation-delay:0.2s">@dil.T("akilli.aciklama", "Aydınlatma ve sensör teknolojisiyle entegre, modern banyolar için yenilikçi çözümler.")</p>
        </div>
    </section>

    <section class="vizit-section">
        <div class="vizit-section-icerik">

            <div class="mb-6 d-flex flex-wrap gap-4 align-center">
                <div class="filter-select-wrapper">
                    <MudSelect T="string" Label="@dil.T("akilli.urunAilesi", "Ürün Ailesi")"
                               Clearable="true"
                               Value="_seciliAile"
                               ValueChanged="@AileDegisti"
                               Variant="Variant.Outlined">
                        @foreach (var aile in _urunAileleri)
                        {
                            <MudSelectItem Value="aile">@aile</MudSelectItem>
                        }
                    </MudSelect>
                </div>
                <div class="filter-select-wrapper">
                    <MudSelect T="string" Label="@dil.T("akilli.kategori", "Kategori")"
                               Clearable="true"
                               Value="_seciliKategori"
                               ValueChanged="@KategoriDegisti"
                               Variant="Variant.Outlined">
                        @foreach (var kat in _kategoriler)
                        {
                            <MudSelectItem Value="kat">@kat</MudSelectItem>
                        }
                    </MudSelect>
                </div>
            </div>

            @if (_yukleniyor)
            {
                <MudProgressCircular Indeterminate="true" Class="my-8" />
            }
            else if (_urunler.Count == 0)
            {
                <MudText Typo="Typo.body1" Class="my-8">@dil.T("akilli.bos", "Bu kriterlere uygun ürün bulunamadı.")</MudText>
            }
            else
            {
                <div class="stitch-urun-grid">
                    @foreach (var urun in _urunler)
                    {
                        <StitchUrunKart Urun="urun" OnClick="UrunDetayaGit" />
                    }
                </div>
            }
        </div>
    </section>

</div>
